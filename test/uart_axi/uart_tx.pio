; 8N1 UART TX — classic Pico-style program for Kraken over AXI.
; OUT and side-set both map to the same TX pin (gpio0).
; With .side_set 1 opt: pull/set [7] → 8 SM clocks; out/jmp [6] → 7 each
; (14 clocks/data bit on this RTL). Pico host often still uses /8 clkdiv.

.program uart_tx
.side_set 1 opt

.wrap_target
    pull       side 1 [7]  ; idle/stop high; stall here if TX empty
    set x, 7   side 0 [7]  ; start bit low for 8 clocks
bitloop:
    out pins, 1       [6]  ; data bit
    jmp x-- bitloop   [6]
.wrap
